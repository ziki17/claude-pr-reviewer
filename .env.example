# docker compose reads this as .env (cp .env.example .env). Never commit .env.

# Claude auth: uncomment ONE of these.
# Anthropic API key (pay per token; MONTHLY_BUDGET_USD is then a real spend guard).
# ANTHROPIC_API_KEY=
# Subscription token from `claude setup-token` (run it on a machine with a browser).
# CLAUDE_CODE_OAUTH_TOKEN=

# GitHub token used by gh. Reviews are posted as this token's user. It needs
# read access to the org's repos and permission to comment on pull requests.
# GH_TOKEN=

# Seconds between ticks.
INTERVAL_SECONDS=300

# DRY_RUN=1 lists candidate PRs without calling Claude. NO_POST=1 runs the full
# pipeline and writes the would-be review to last-payload.json in the state
# directory instead of posting.
DRY_RUN=0
NO_POST=0
