# Optional secrets for auto-review-prs.sh, sourced from
# ~/.config/auto-pr-review/env when that file exists. launchd does not inherit
# your shell environment, so put them here instead of ~/.zshrc.
#
#   cp config/env.example ~/.config/auto-pr-review/env
#   chmod 600 ~/.config/auto-pr-review/env
#
# Leave everything commented out to use your Claude Code login and the gh keyring.

# Anthropic API key (pay per token). In `claude -p` it takes precedence over a
# subscription login, and MONTHLY_BUDGET_USD becomes a real spend guard.
# ANTHROPIC_API_KEY=

# Subscription token from `claude setup-token`, for machines without a browser login.
# CLAUDE_CODE_OAUTH_TOKEN=

# GitHub token for gh; the reviews are posted as this token's user.
# GH_TOKEN=
